{
  "name": "pulsehook-flagsmith",
  "version": "1.0.0",
  "private": true,
  "description": "PulseHook — a developer webhook SDK quickstart lab, A/B tested end-to-end with self-hosted Flagsmith (Toggle Wars Track 01).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
