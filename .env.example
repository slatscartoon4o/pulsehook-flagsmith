# 复制为 .env 后按需修改；.env 已被 .gitignore 忽略，请勿提交真实密钥。
# 所有值都是本地开发用的占位符/默认值。

# Flagsmith 对外端口（避开 80/3000/8000/8080）
FLAGSMITH_PORT=18000
# task processor 的健康检查端口
FLAGSMITH_PROC_PORT=18001

# PostgreSQL（容器内）
POSTGRES_DB=flagsmith
POSTGRES_USER=flagsmith
POSTGRES_PASSWORD=change_me_local_only

# Django
FLAGSMITH_SECRET_KEY=change_me_local_only_secret

# ---- PulseHook 应用（由 scripts/bootstrap-flagsmith.mjs 自动写入 .env）----
FLAGSMITH_API_URL=http://localhost:18000/api/v1/
FLAGSMITH_EVENTS_URL=http://localhost:18000/api/
# 服务端用的环境 key（SDK 评估与事件上报）
FLAGSMITH_ENVIRONMENT_KEY=
# 可选：显式指定下发给浏览器的 client-side key。
# 留空时，只有当 FLAGSMITH_ENVIRONMENT_KEY 不是 ser. 开头才会下发它；
# 服务端私钥（ser. 前缀）永远不会被回显到页面或 SDK 片段里。
FLAGSMITH_CLIENT_KEY=
FLAGSMITH_ENVIRONMENT_API_KEY=
FLAGSMITH_ADMIN_EMAIL=admin@pulsehook.local
FLAGSMITH_ADMIN_PASSWORD=
PORT=3000
